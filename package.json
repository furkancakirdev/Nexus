{
  "name": "marlin-nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "client": "vite --host 127.0.0.1",
    "server": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:unit": "npm test",
    "test:integration": "node --test server/apiDatabase.integration.test.mjs server/authBoundary.test.mjs server/hr/hrApi.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=50 --test-coverage-functions=50 --test-coverage-branches=40 server/*.test.mjs",
    "quality:format": "node scripts/quality-gates.mjs format",
    "quality:lint": "node scripts/quality-gates.mjs lint",
    "quality:typecheck": "node scripts/quality-gates.mjs typecheck",
    "quality:secrets": "node scripts/quality-gates.mjs secrets",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.44.0",
    "@vitejs/plugin-react": "5.0.4",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "mssql": "^12.7.0",
    "multer": "^2.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.9.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "concurrently": "10.0.4"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.21",
    "browserslist": "4.28.9",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "qs": "6.16.0"
  }
}
