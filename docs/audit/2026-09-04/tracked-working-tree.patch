+/* --- KANITLI STOK ARAŞTIRMASI DÜZENİ --- */
+.inventory-research-layout {
+  display: grid;
+  grid-template-columns: 340px minmax(0, 1fr);
+  gap: 20px;
+  align-items: start;
+  margin-top: 16px;
+}
+
+.inventory-search-panel {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  max-height: calc(100vh - 180px);
+  position: sticky;
+  top: 76px;
+  padding: 16px;
+  overflow: hidden;
+}
+
+.inventory-search-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  font-size: 0.85rem;
+  font-weight: 600;
+  color: var(--muted);
+  border-bottom: 1px solid var(--line);
+  padding-bottom: 8px;
+}
+
+.inventory-product-list {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  overflow-y: auto;
+  max-height: calc(100vh - 280px);
+  padding-right: 4px;
+}
+
+.inventory-product {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  text-align: left;
+  padding: 10px 12px;
+  border-radius: var(--radius-sm);
+  border: 1px solid transparent;
+  background: var(--surface-soft);
+  cursor: pointer;
+  transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
+  width: 100%;
+}
+
+.inventory-product:hover {
+  background: var(--surface-subtle);
+  border-color: var(--line);
+}
+
+.inventory-product.is-selected {
+  background: color-mix(in srgb, var(--blue) 12%, var(--surface));
+  border-color: var(--blue);
+  box-shadow: 0 1px 4px rgba(2, 132, 199, 0.15);
+}
+
+.inventory-product span {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  min-width: 0;
+  flex: 1;
+}
+
+.inventory-product strong {
+  font-size: 0.86rem;
+  color: var(--ink);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.inventory-product small {
+  font-size: 0.76rem;
+  color: var(--muted);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  max-width: 220px;
+}
+
+.inventory-product em {
+  font-style: normal;
+  font-size: 0.7rem;
+  font-weight: 700;
+  padding: 2px 6px;
+  border-radius: 4px;
+  background: var(--line);
+  color: var(--muted);
+  margin-left: 8px;
+  flex-shrink: 0;
+}
+
+.inventory-product.is-selected em {
+  background: var(--blue);
+  color: #fff;
+}
+
+.inventory-research-content {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  min-width: 0;
+}
+
+.inventory-product-hero {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  padding: 20px 24px;
+}
+
+.inventory-product-hero h2 {
+  margin: 2px 0 4px;
+  font-size: 1.25rem;
+}
+
+.inventory-product-hero small {
+  color: var(--muted);
+  font-weight: 600;
+  font-size: 0.8rem;
+}
+
+.inventory-product-hero p {
+  margin: 0;
+  color: var(--muted);
+  font-size: 0.88rem;
+}
+
+.inventory-kpis {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
+  gap: 16px;
+}
+
+.inventory-evidence-diagnostics {
+  margin-bottom: 12px;
+  padding: 14px 18px;
+}
+
+@media (max-width: 1024px) {
+  .inventory-research-layout {
+    grid-template-columns: 1fr;
+  }
+  .inventory-search-panel {
+    position: static;
+    max-height: 380px;
+  }
+  .inventory-product-list {
+    max-height: 260px;
+  }
+}
